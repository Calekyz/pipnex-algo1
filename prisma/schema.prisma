generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  clerkId       String          @unique
  email         String          @unique
  name          String?
  status        UserStatus      @default(PENDING)
  credits       Int             @default(0)
  plan          String?         // "PRO", "GOLD", "PLATINUM"
  planExpiry    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  payments      PaymentProof[]
}

model PaymentProof {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  method        String       // "MPESA" or "CRYPTO"
  amount        Int          // Amount in KES or USD
  requestedPlan String?      // "PRO", "GOLD", "PLATINUM"  <-- NEW
  reference     String?      // M-Pesa Code or TX Hash
  screenshotUrl String?      // URL to uploaded image
  status        ProofStatus  @default(SUBMITTED)
  verifiedBy    String?      // Admin email
  createdAt     DateTime     @default(now())
  verifiedAt    DateTime?
}

enum UserStatus {
  PENDING
  PENDING_VERIFICATION
  ACTIVE
  EXPIRED
}

enum ProofStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}
